# =========================
# 项目基础信息
# =========================
PROJECT_NAME=FastAPI Starter

# =========================
# 数据库配置
# 格式: postgresql+psycopg://用户名:密码@主机:端口/数据库名
# 本地开发: localhost
# Docker Compose: 自动覆盖为 db:5432
# =========================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fastapi_db

# Redis 缓存 / 消息队列
# 格式: redis://密码@主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT 鉴权
# SECRET_KEY: 请替换为足够长的随机字符串（至少 32 位，建议 openssl rand -hex 32）
# ALGORITHM: 签名算法，默认 HS256
# ACCESS_TOKEN_EXPIRE_MINUTES: Token 过期时间（分钟）
# =========================
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# CORS 跨域配置
# 逗号分隔的允许来源，支持前端开发地址
# =========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# =========================
# 日志格式
# text: 可读文本格式（本地开发推荐）
# json: JSON 结构化日志（生产环境推荐）
# =========================
LOG_FORMAT=text

# =========================
# LLM 大模型配置（兼容 OpenAI 格式的 API）
# LLM_PROVIDER: 供应商名称，可选 deepseek / openai / ollama / custom
# LLM_API_KEY: API 密钥（可按用户配置个人密钥替代）
# LLM_BASE_URL: API 端点地址
# LLM_MODEL_NAME: 模型名称，如 deepseek-chat / gpt-4o-mini / qwen2.5
# EMBEDDING_MODEL_NAME: Embedding 模型名称，如 bge-m3 / text-embedding-3-small
# =========================
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-v4-pro
EMBEDDING_MODEL_NAME=bge-m3

# Mock 模式 — 设为 true 可无需 API Key，使用预设回复进行演示或测试
LLM_MOCK=false

# =========================
# LLM 成本统计（仅用于账单估算，不影响功能）
# 单位: 美元 / 每千 Token
# 设为 0 则跳过成本计算
# =========================
LLM_INPUT_PRICE_PER_1K_TOKENS=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS=0

# =========================
# RAG 知识库配置
# EMBEDDING_DIMENSION: 向量维度，需与 Embedding 模型匹配
#   bge-m3 = 1024
#   text-embedding-3-small = 1536
# =========================
EMBEDDING_DIMENSION=1024
